# The data release is not redistributed here; see data/README.md.
data/*.jsonl
data/manifest.json
data/SHA256SUMS

# Intermediate pickles and JSON, all regenerated by src/run_all.py.
cache/*
!cache/.gitkeep

# Generated figures and numbers, tracked copies live in paper/figs/.
figures/*
!figures/.gitkeep
results/*
!results/.gitkeep
!results/numbers.txt

# LaTeX build products
paper/*.aux
paper/*.log
paper/*.out
paper/*.synctex.gz

__pycache__/
*.pyc
.DS_Store
.venv/
