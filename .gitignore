# The data release is not redistributed here; see data/README.md.
data/*.jsonl
data/manifest.json
data/SHA256SUMS

# Intermediate pickles and JSON, all regenerated by src/run_all.py.
cache/*
!cache/.gitkeep

# PNG previews of the figures; the PDFs the manuscript includes are tracked in paper/figs/.
figures/*
!figures/.gitkeep

# results/numbers.txt is tracked; nothing else lands here.
results/*
!results/.gitkeep
!results/numbers.txt

# LaTeX build products
paper/*.aux
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.bbl
paper/*.blg

__pycache__/
*.pyc
.DS_Store
.venv/
